<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>10.0</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Workes.ConsoleSystem.Microsoft.Extensions.Logging</PackageId>
    <Version>0.1.0</Version>
    <PackageReleaseNotes>Initial provider with configurable level mapping, category and exception propagation, external scopes, and disposal-safe forwarding.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Workes</Authors>
    <Company>Workes</Company>
    <Product>Workes.ConsoleSystem.Microsoft.Extensions.Logging</Product>
    <Description>Microsoft.Extensions.Logging provider that forwards records to Workes.ConsoleSystem.</Description>
    <PackageTags>logging console microsoft-extensions logging-provider</PackageTags>
    <PackageProjectUrl>https://github.com/WorkesLibraries/Workes.ConsoleSystem.Microsoft.Extensions.Logging</PackageProjectUrl>
    <RepositoryUrl>https://github.com/WorkesLibraries/Workes.ConsoleSystem.Microsoft.Extensions.Logging.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2026 Workes</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Workes.ConsoleSystem" Version="0.9.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>
</Project>